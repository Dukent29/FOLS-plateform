generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

enum LeadStatus {
  NEW
  QUALIFICATION
  QUOTE_TO_PREPARE
  QUOTE_SENT
  WON
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
}

enum MissionStatus {
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommunicationType {
  NOTE
  EMAIL
  PHONE
  FOLLOW_UP
  SYSTEM
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(MANAGER)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  siret     String?
  address   String?
  city      String?
  postalCode String?
  contacts  Contact[]
  leads     Lead[]
  quotes    Quote[]
  missions  Mission[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

model Contact {
  id        String    @id @default(cuid())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  firstName String
  lastName  String?
  email     String
  phone     String
  leads     Lead[]
  quotes    Quote[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([companyId])
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  active      Boolean  @default(true)
  defaultHourlyRateCents Int?
  leads       Lead[]
  quoteItems  QuoteItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id             String          @id @default(cuid())
  reference      String          @unique
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String
  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  serviceId      String?
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceLabel   String
  siteType       String?
  city           String
  desiredStart   DateTime?
  timeRange      String?
  duration       String?
  guardCount     Int?
  urgency        String
  description    String
  source         String          @default("website")
  status         LeadStatus      @default(NEW)
  nextActionAt   DateTime?
  communications Communication[]
  quotes         Quote[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([companyId])
  @@index([contactId])
  @@index([nextActionAt])
}

model Communication {
  id        String            @id @default(cuid())
  leadId    String
  lead      Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      CommunicationType @default(NOTE)
  content   String
  createdBy String?
  createdAt DateTime          @default(now())

  @@index([leadId, createdAt])
}

model Quote {
  id          String      @id @default(cuid())
  reference   String      @unique
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId   String
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  status      QuoteStatus @default(DRAFT)
  notes       String?
  subtotalCents Int
  taxRateBps  Int         @default(2000)
  taxCents    Int
  totalCents  Int
  validUntil  DateTime?
  items       QuoteItem[]
  missions    Mission[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([leadId])
  @@index([companyId])
}

model QuoteItem {
  id             String   @id @default(cuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int      @default(1)
  hours          Decimal  @default(1) @db.Decimal(10, 2)
  unitPriceCents Int
  surchargeCents Int      @default(0)
  lineTotalCents Int

  @@index([quoteId])
}

model Mission {
  id               String        @id @default(cuid())
  reference        String        @unique
  quoteId          String?
  quote            Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  companyId        String?
  company          Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title            String
  location         String
  serviceLabel     String
  startsAt         DateTime
  endsAt           DateTime
  requiredPersonnel Int          @default(1)
  instructions     String?
  status           MissionStatus @default(PLANNED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([companyId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
