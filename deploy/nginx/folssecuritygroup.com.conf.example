# Install this as /etc/nginx/sites-available/folssecuritygroup.com after
# confirming the certificate paths match the existing working HTTPS site.

limit_req_zone $binary_remote_addr zone=fols_lead_submissions:10m rate=1r/m;

upstream fols_security_app {
    server 127.0.0.1:3001;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name folssecuritygroup.com www.folssecuritygroup.com;

    return 301 https://folssecuritygroup.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.folssecuritygroup.com;

    ssl_certificate /etc/letsencrypt/live/folssecuritygroup.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/folssecuritygroup.com/privkey.pem;

    return 301 https://folssecuritygroup.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name folssecuritygroup.com;

    ssl_certificate /etc/letsencrypt/live/folssecuritygroup.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/folssecuritygroup.com/privkey.pem;

    client_max_body_size 1m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    location = /api/public/leads {
        limit_req zone=fols_lead_submissions burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://fols_security_app;
    }

    location / {
        proxy_pass http://fols_security_app;
    }
}
